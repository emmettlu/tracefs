[Unit]
Description=AgentComputerFS (acfs) daemon
Documentation=https://github.com/emmettlu/tracefs/blob/main/AGENTS.md
After=local-fs.target

[Service]
Type=notify
# The socket is root:root 0666: any local user may connect, and acfsd authorizes each
# request by the caller's uid (SO_PEERCRED). No group or user is configured here.
ExecStart=/usr/local/bin/acfsd
Restart=on-failure
# Processes started with `acfs run` live in their own scopes under acfs.slice (limits in acfs.slice.d/), and
# mounts outlive the daemon: stopping it only stops the daemon.
MemoryMax=2G
OOMScoreAdjust=-500

[Install]
WantedBy=multi-user.target
